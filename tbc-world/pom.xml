<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.tbc</groupId>
    <artifactId>tbc-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>tbc-world</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.tbc</groupId>
      <artifactId>tbc-common</artifactId>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-all</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <phase>test</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <includes>
                <include>org/tbc/world/persist/PlayerPersist*</include>
                <include>org/tbc/world/combat/Combat*</include>
                <include>org/tbc/world/combat/MeleeTable*</include>
                <include>org/tbc/world/spell/SpellEngine*</include>
                <include>org/tbc/world/spell/SpellCastTargets*</include>
                <include>org/tbc/world/content/Content*</include>
              </includes>
              <rules>
                <rule>
                  <element>CLASS</element>
                  <includes>
                    <include>org.tbc.world.persist.PlayerPersist</include>
                    <include>org.tbc.world.combat.Combat</include>
                    <include>org.tbc.world.combat.MeleeTable</include>
                    <include>org.tbc.world.spell.SpellEngine</include>
                    <include>org.tbc.world.spell.SpellCastTargets</include>
                    <include>org.tbc.world.content.Content</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.tbc.world.WorldMain</mainClass>
                </transformer>
              </transformers>
              <createDependencyReducedPom>false</createDependencyReducedPom>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
